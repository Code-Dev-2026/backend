# ==============================================================================
# CAMINO SEGURO - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Sistema de Control Operativo y Seguridad para Rutas Escolares
# Colegio San Benito del Otún / Transportes Camino Seguro S.A.S.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16 + PostGIS 3.4)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=camino_seguro_db
DB_USER=app_user
DB_PASSWORD=dev_app_user_password_2026
DB_OWNER_USER=app_owner
DB_OWNER_PASSWORD=dev_owner_password_san_benito_2026
DB_SSL=false
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 3. Redis & BullMQ (Colas FIFO Offline, Caché y Sockets)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_secret_password
REDIS_DB=0

# ------------------------------------------------------------------------------
# 4. Cryptography & Security Keys (Ley 1581 Habeas Data Menores)
# Unified format: key_version:iv_b64:tag_b64:ciphertext_b64
# ------------------------------------------------------------------------------
CURRENT_KEY_VERSION=v1
# Master AES-256-GCM Key (32 bytes base64 encoded)
APP_ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# HMAC Blind Index Secret Key (32 bytes base64 encoded para búsqueda exacta)
APP_BLIND_INDEX_HMAC_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# ------------------------------------------------------------------------------
# 5. Authentication & Session Tokens (JWT & Argon2id + TOTP MFA)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=c4m1n0_s3gur0_4cc3ss_s3cr3t_jwt_256_b1ts_k3y_m1n1mum_l3ngth_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=c4m1n0_s3gur0_r3fr3sh_s3cr3t_jwt_256_b1ts_k3y_m1n1mum_l3ngth_2026
JWT_REFRESH_EXPIRATION=7d
MFA_ISSUER=CaminoSeguroSanBenito

# ------------------------------------------------------------------------------
# 6. Real-Time Telemetry & Messaging (MQTT & WebSocket)
# ------------------------------------------------------------------------------
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=backend_telemetry_engine
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1
MQTT_TOPIC_GPS_INGEST=telemetry/vehicles/+/gps
MQTT_TOPIC_ALERT_INGEST=telemetry/vehicles/+/alerts

SOCKET_IO_PORT=3001
SOCKET_IO_PATH=/socket.io

# ------------------------------------------------------------------------------
# 7. Push Notifications (Firebase Cloud Messaging - FCM)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=camino-seguro-san-benito
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@camino-seguro-san-benito.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 8. SMS / WhatsApp Fallback Gateway (e.g., Twilio / AWS SNS / Mock)
# ------------------------------------------------------------------------------
SMS_GATEWAY_PROVIDER=mock
SMS_GATEWAY_API_KEY=replace_with_sms_api_key
SMS_GATEWAY_SENDER_ID=CAMINOSEGURO

# ------------------------------------------------------------------------------
# 9. Observability & Forensic Audit Logging (RNF-08)
# ------------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json
AUDIT_LOG_ENABLED=true
METRICS_PORT=9090
