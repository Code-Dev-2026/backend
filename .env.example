NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Base de Datos PostgreSQL 16 + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=camino_seguro_db
DB_USER=app_user
DB_PASSWORD=camino_seguro_pass

# Seguridad Criptográfica (AES-256-GCM y Blind Index HMAC)
CURRENT_KEY_VERSION=v1
APP_ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_BLIND_INDEX_HMAC_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Autenticación JWT y MFA
JWT_SECRET=super_secret_jwt_key_camino_seguro_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Broker IoT MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
