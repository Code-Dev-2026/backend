# ==============================================================================
# CAMINO SEGURO - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# All sensitive credentials and keys must be managed through Secret Managers
# (e.g., AWS Secrets Manager, HashiCorp Vault, GCP Secret Manager) in production.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL 16 + PostGIS 3.4)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=camino_seguro_db
DB_USER=app_user
DB_PASSWORD=replace_with_secure_app_user_password
DB_OWNER_USER=app_owner
DB_OWNER_PASSWORD=replace_with_secure_app_owner_password
DB_SSL=false
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_CONNECTION_TIMEOUT_MS=5000

# Cryptography & Security Keys [PROPUESTA]
# Format: key_version:iv:tag:ciphertext
CURRENT_KEY_VERSION=v1
# Master AES-256-GCM Key (32 bytes base64 encoded)
APP_ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# HMAC Blind Index Secret Key (32 bytes base64 encoded)
APP_BLIND_INDEX_HMAC_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Authentication & Session Tokens (JWT & Argon2id)
JWT_ACCESS_SECRET=replace_with_at_least_256_bit_random_string_for_access_token
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_at_least_256_bit_random_string_for_refresh_token
JWT_REFRESH_EXPIRATION=7d
MFA_ISSUER=CaminoSeguroSanBenito

# Real-Time Telemetry & Messaging (MQTT & WebSocket)
MQTT_BROKER_URL=mqtts://broker.caminoseguro.edu.co:8883
MQTT_CLIENT_ID=backend_telemetry_engine
MQTT_USERNAME=camino_backend_service
MQTT_PASSWORD=replace_with_broker_password
MQTT_QOS=1
MQTT_TOPIC_GPS_INGEST=telemetry/vehicles/+/gps
MQTT_TOPIC_ALERT_INGEST=telemetry/vehicles/+/alerts

SOCKET_IO_PORT=3001
SOCKET_IO_PATH=/socket.io

# Push Notifications (Firebase Cloud Messaging - FCM)
FIREBASE_PROJECT_ID=camino-seguro-san-benito
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@camino-seguro-san-benito.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# SMS / WhatsApp Fallback Gateway (e.g., Twilio / AWS SNS)
SMS_GATEWAY_PROVIDER=mock
SMS_GATEWAY_API_KEY=replace_with_sms_api_key
SMS_GATEWAY_SENDER_ID=CAMINOSEGURO

# Observability & Audit Logging
LOG_LEVEL=debug
LOG_FORMAT=json
AUDIT_LOG_ENABLED=true
METRICS_PORT=9090
