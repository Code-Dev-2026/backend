NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Base de Datos PostgreSQL 16 + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=camino_seguro_db
DB_USER=app_user
DB_PASSWORD=camino_seguro_pass
CUSTODY_USE_POSTGRES=false
CUSTODY_MORNING_JOB_ENABLED=false
CUSTODY_MORNING_JOB_HOUR=5
CUSTODY_MORNING_JOB_MINUTE=0

# Seguridad Criptográfica (AES-256-GCM y Blind Index HMAC)
CURRENT_KEY_VERSION=v1
APP_ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_BLIND_INDEX_HMAC_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Autenticación JWT y MFA
JWT_SECRET=super_secret_jwt_key_camino_seguro_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Correo saliente para el OTP de doble factor (vacío = log en desarrollo)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Camino Seguro <no-reply@caminoseguro.edu.co>

# Broker IoT MQTT (MQTTS / mTLS - Issue #12, sin credenciales reales en plantilla)
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtts://localhost:8883
MQTT_TOPIC_PATTERN=telemetry/vehicles/+/gps
MQTT_CLIENT_ID=camino-seguro-backend-telemetry
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_CA_PATH=
MQTT_TLS_CERT_PATH=
MQTT_TLS_KEY_PATH=
MQTT_TLS_REJECT_UNAUTHORIZED=true
MQTT_RECONNECT_PERIOD_MS=5000

# Telemetría IoT y particionamiento PostgreSQL (Issue #12)
TELEMETRY_USE_POSTGRES=false
TELEMETRY_BATCH_SIZE=100
TELEMETRY_BATCH_FLUSH_MS=100
TELEMETRY_MAX_ACCURACY_METERS=30
TELEMETRY_PARTITION_JOB_ENABLED=false
TELEMETRY_PARTITION_MONTHS_AHEAD=2
TELEMETRY_RETENTION_DAYS=180
TELEMETRY_PARTITION_JOB_INTERVAL_MS=3600000
